--- !u!114 &396561673
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 396561670}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f3230a513af7770428740d2830288726, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _caller: {fileID: 396561675}
  _content: "\rBy direct command of Lady Zenise, the upper chamber remains under
    full lockdown.  \r\nThe gate is sealed by sigil. No entry is permitted under
    any circumstance.\r\r\nIf you encounter a feline shadow, you are to illuminate
    it immediately.  \r\nMaintain full light contact until the entity dissipates. 
    \r\nDo not, under any condition, allow it to advance.\r\n\rLady Zenise\u2019s
    focus must not be interrupted.  \r\nHold your post. Follow orders.\n\n- A.\nCaptain
    of the Guard"
