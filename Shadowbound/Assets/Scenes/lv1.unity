--- !u!114 &1894627826
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1894627821}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f3230a513af7770428740d2830288726, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _caller: {fileID: 1894627827}
  _content: 'There is spoken of in obscure tales an unknown creature, called the
    Soul Devourer, whose nature consists in the consumption of souls.

    Few accounts
    have come down to us, yet testimony is scattered throughout ancient scrolls,
    common folklore, and the secret writings of magi.

    It is no longer dismissed,
    for a single specimen has been sighted near the city and is now confined within
    the castle walls.

    Thus, inquiry must persist, that the true nature of this
    being may be revealed.'
