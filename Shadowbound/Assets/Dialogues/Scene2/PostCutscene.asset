  m_Script: {fileID: 11500000, guid: 2666342667ed35e49a322785f6f47e64, type: 3}
  m_Name: PostCutscene
  m_EditorClassIdentifier: 
  paragraphs:
  - speakerName: Momo
    text: So she's my sister...
  - speakerName: Momo
    text: I can't help but feel guilty for forgetting something so important.
  - speakerName: Momo
    text: And I don't even know if she's still alive...
  - speakerName: Momo
    text: I have to get out of here, before it's too late to keep my promise.
